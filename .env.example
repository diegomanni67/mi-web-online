# Server-only database credential. Never expose it with NEXT_PUBLIC_.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Member access. Generate long random values before launch.
KOTERIE_SESSION_SECRET=replace-with-at-least-32-random-characters
KOTERIE_ACADEMY_CODE=replace-with-private-academy-code
KOTERIE_STUDIO_CODE=replace-with-private-studio-code
KOTERIE_TEACHER_CODE=replace-with-private-teacher-code
KOTERIE_ADMIN_CODE=replace-with-private-admin-code

# AI is opt-in. Leave false to guarantee Koterie does not call a provider.
KOTERIE_AI_ENABLED=false
GOOGLE_GENERATIVE_AI_API_KEY=

# Keep false for launch: teachers pre-register students from /admin
KOTERIE_ALLOW_SELF_ENROLLMENT=false

# Neon Object Storage (private Koterie materials)
KOTERIE_STORAGE_BUCKET=koterie-materials
KOTERIE_STORAGE_ENDPOINT=https://br-wispy-mouse-ay9zgzuk.storage.c-5.us-east-2.aws.neon.tech
KOTERIE_STORAGE_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
